# AquaPilot runtime configuration.
# Copy to `.env` only if you run the server through a tool that loads it;
# `npm start` reads plain environment variables, so `export` also works.
# Every variable is optional — the defaults below are what runs with no config.

# HTTP port for both the API and the static client.
PORT=5173

# Simulation loop cadence in milliseconds (default 1000).
TICK_MS=1000

# Simulated minutes advanced per tick (default 2).
SIM_MINUTES_PER_TICK=2

# Opt-in access control. When set, every /api/* route except /api/health and
# /api/auth-required requires `Authorization: Bearer <token>`, and WebSocket
# clients must offer the subprotocol `token.<token>`.
# Leave empty for local development. Use a long random value when shared:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AQUAPILOT_TOKEN=

# Structured log level: debug | info | warn | error (default info).
LOG_LEVEL=info

# SQLite file for decisions, alarms and replay snapshots (default data/aquapilot.db).
AQUAPILOT_DB=data/aquapilot.db

# Set to 0 to disable persistence entirely (also automatic on Node 20,
# where node:sqlite does not exist).
AQUAPILOT_PERSIST=1

# Optional LLM dialogue enhancement.
#
# The supported way to connect a model is the UI: top bar -> 模型设置. It speaks
# OpenAI-compatible, Anthropic Messages and Google Gemini, discovers the model
# list from the endpoint and stores the key in data/llm-config.json (mode 0600).
#
# The variables below are only a fallback for headless deployments where nobody
# opens the dialog; when a UI-saved config exists it wins. Never commit the key.
AQUAPILOT_LLM_BASE_URL=
AQUAPILOT_LLM_MODEL=
AQUAPILOT_LLM_API_KEY=
AQUAPILOT_LLM_TIMEOUT_MS=8000
# Where the UI-saved config is persisted (default data/llm-config.json).
AQUAPILOT_LLM_CONFIG=

# Agent configuration (persona / prompts / skills / hooks / constraints).
# The supported way is the UI (top bar -> Agent 设置) or chat commands; this
# variable only relocates the file. Defaults to data/agent-config.json (0600).
AQUAPILOT_AGENT_CONFIG=

# Flowsheet document (units, connections, hand-placed positions and connection
# waypoints). Saved whenever a topology is applied or a preset is switched, and
# restored on the next start; a damaged file falls back to the standard plant.
AQUAPILOT_TOPOLOGY=
