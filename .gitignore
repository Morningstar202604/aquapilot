# Dependencies
node_modules/

# Build output
/dist/
/out/

# Test and tooling artifacts
test-results.json
/coverage/
*.tsbuildinfo
.stryker-tmp/

# Environment and secrets — never commit these
.env
.env.*
!.env.example

# Local AQG working state (the tracked ledgers under .aqg/code-construction/ stay in the repo)
.aqg/current_ledger.md

# Scratch dirs and one-off probe output
.tmp/
.tmp_*
.tmp-*

# Runtime state written by the server (SQLite DB, topology history, agent/LLM config).
# Anchored to the repository root: `src/sim/data/` holds tracked reference data and must not be caught here.
/data/
/backups/
.ci-*.db
.ci-*

# Logs and OS noise
*.log
.DS_Store
Thumbs.db
.v2c/
reports/
.workbuddy/
