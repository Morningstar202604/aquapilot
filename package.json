{
  "name": "aquapilot",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "AI-operated wastewater treatment plant simulator with topology-driven solvers",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/index.mjs",
    "harness": "tsx scripts/harness.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "lint": "eslint src tests",
    "ci": "bash scripts/ci-gate.sh",
    "e2e": "tsx scripts/e2e-ci.ts",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "backup": "tsx scripts/backup.ts",
    "mutation": "stryker run",
    "docker:build": "docker build -t aquapilot:local .",
    "docker:run": "docker run --rm -p 5173:5173 -v aquapilot-data:/app/data aquapilot:local"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "license": "MIT",
  "author": "AquaPilot contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Morningstar202604/aquapilot.git"
  },
  "homepage": "https://github.com/Morningstar202604/aquapilot#readme",
  "bugs": {
    "url": "https://github.com/Morningstar202604/aquapilot/issues"
  },
  "keywords": [
    "wastewater",
    "simulation",
    "asm1",
    "bsm1",
    "activated-sludge",
    "digital-twin",
    "ai-agents",
    "process-control"
  ],
  "engines": {
    "node": ">=20.19.0"
  }
}
