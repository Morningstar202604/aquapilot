{
  "name": "aquapilot",
  "version": "0.9.0",
  "private": true,
  "allowScripts": {
    "esbuild": true
  },
  "type": "module",
  "description": "Topology-driven wastewater simulation prototype with an AI operator, ASM1 water train, and auditable control guardrails",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/index.mjs",
    "harness": "tsx scripts/harness.ts",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test && npm run build",
    "lint": "eslint src tests",
    "ci": "bash scripts/ci-gate.sh",
    "e2e": "tsx scripts/e2e-ci.ts",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "backup": "tsx scripts/backup.ts",
    "mutation": "stryker run",
    "check:version": "node scripts/check-version.mjs",
    "docker:build": "docker build -t aquapilot:local .",
    "docker:run": "docker run --rm -p 5173:5173 -e HOST=0.0.0.0 -e AQUAPILOT_TOKEN -v aquapilot-data:/app/data aquapilot:local",
    "media": "tsx scripts/media.ts",
    "walkthrough": "tsx scripts/walkthrough.mjs",
    "benchmark:prove": "tsx scripts/prove-benchmark.ts",
    "cli": "node dist/cli.mjs",
    "exe": "npm run build && node scripts/build-exe.mjs",
    "exercise": "tsx scripts/exercise-realworld.ts"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valibot": "^1.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "license": "MIT",
  "author": "AquaPilot contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Morningstar202604/aquapilot.git"
  },
  "homepage": "https://github.com/Morningstar202604/aquapilot#readme",
  "bugs": {
    "url": "https://github.com/Morningstar202604/aquapilot/issues"
  },
  "keywords": [
    "wastewater",
    "simulation",
    "asm1",
    "bsm1",
    "activated-sludge",
    "digital-twin",
    "ai-agents",
    "process-control"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "aquapilot": "./dist/cli.mjs"
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
